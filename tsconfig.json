{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./out",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020"],
    "baseUrl": ".",
    "paths": {
      "vscode": ["./src/tests/__mocks__/vscode.js"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}